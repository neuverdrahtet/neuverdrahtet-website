rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function hasRole(roles) { return myRole() in roles; }
    function isAdmin() { return myRole() == 'admin'; }
    function isAdminOrBuero() { return hasRole(['admin', 'buero']); }
    function isAnyRole() { return hasRole(['admin', 'buero', 'mitarbeiter']); }

    // Kundenportal (rein lesend): eigene Rolle 'kunde', verknüpft über
    // users/{uid}.kundeId statt mitarbeiterId. Bewusst NICHT Teil von
    // isAnyRole()/hasRole() oben - ein Kunde bekommt dadurch aus der
    // generischen Collection-Regel unten gar nichts, sondern ausschließlich
    // die unten einzeln aufgeführten, auf sein eigenes kundeId gefilterten
    // Leserechte (kunden/angebote/rechnungen/termine).
    function isKunde() { return myRole() == 'kunde'; }
    function myKundeId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.kundeId
        : null;
    }
    // Sensible Geschäfts-/Finanz-/Personaldaten: nur Admin + Büro
    // (spiegelt ROUTE_ROLLEN aus db.js für kunden/katalog/angebote/rechnungen/
    // mahnungen/ausgaben/vorlagen/textbausteine/kanban).
    function isSensitiveCollection(collectionId) {
      return collectionId in [
        'kunden', 'mitarbeiter', 'katalog', 'angebote', 'auftragsbestaetigungen', 'rechnungen', 'gutschriften',
        'mahnungen', 'ausgaben', 'vorlagen', 'textbausteine', 'kanbanSpalten',
        'lagerbewegungen', 'emails', 'anlagen', 'konten', 'buchungen', 'bankbuchungen', 'anlagegueter',
        'kundenStatus', 'subunternehmer', 'ai_action_log', 'ki_freigaben', 'arbeitsberichte', 'socialPosts',
        'google_oauth_tokens', 'google_calendar_links', 'google_action_log', 'lieferanten', 'inventuren',
        'zahlungsabgleich', 'katalogVorschlaege', 'uploadLinks'
      ];
    }
    // Operative Daten: alle drei Rollen (spiegelt ROUTE_ROLLEN für
    // projekte/plantafel/zeiterfassung/aufgaben/geraete, für alle nutzbar).
    function isSharedCollection(collectionId) {
      return collectionId in [
        'projekte', 'termine', 'zeiterfassung', 'fotos', 'aufgaben', 'dokumente',
        'kategorien', 'nachrichten', 'geraete', 'flotten', 'terminStatus', 'aufgabenStatus',
        'verwendungen', 'fahrten', 'marken', 'urlaubsantraege', 'formulare', 'formularEintraege', 'aufmasse'
      ];
    }

    // --- Login-Bootstrapping (E-Mail+Passwort statt Zugangscode) ---

    // Ein Admin legt hier eine Einladung an (Rolle + Mitarbeiter-Verknüpfung
    // vorbelegt). "get" auf den exakten Dokumentnamen (E-Mail) ist bewusst auch
    // ohne Login erlaubt, damit der Registrierungs-Bildschirm vor dem Anlegen
    // des Kontos prüfen kann, ob überhaupt eine Einladung existiert – "list"
    // bleibt aber gesperrt, damit niemand alle eingeladenen E-Mail-Adressen
    // auflisten kann.
    match /invites/{email} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.token.email == email);
    }

    // Rolle je Mitarbeiter-Konto. Erstellt sich der Mitarbeiter bei der
    // Registrierung selbst an – aber nur, wenn eine passende Einladung
    // existiert und Rolle/Mitarbeiter-ID exakt aus dieser Einladung übernommen
    // werden (verhindert, dass sich jemand selbst zum Admin macht).
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.email))
        && request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.resource.data.email)).data.role
        && (
          // Kunde: über kundeId verknüpft (kein mitarbeiterId-Feld nötig).
          (request.resource.data.role == 'kunde'
            && request.resource.data.kundeId == get(/databases/$(database)/documents/invites/$(request.resource.data.email)).data.kundeId)
          ||
          // Mitarbeiter/Büro/Admin: wie bisher über mitarbeiterId verknüpft.
          (request.resource.data.role != 'kunde'
            && request.resource.data.mitarbeiterId == get(/databases/$(database)/documents/invites/$(request.resource.data.email)).data.mitarbeiterId)
        );
      allow update, delete: if isAdmin();
    }

    // --- Anwendungsdaten ---

    // einstellungen/global: alle eingeloggten Rollen dürfen lesen (Theme,
    // Logo, Firmendaten werden auf praktisch jeder Seite gebraucht), aber nur
    // Admin darf etwas ändern.
    match /einstellungen/{docId} {
      allow read: if isAnyRole();
      allow write: if isAdmin();
    }

    // mitarbeiter/* enthält die volle, sensible Personalakte (Adresse,
    // Geburtsdatum, Stundenlohn/Gehalt, Notfallkontakt, ...) - deshalb wie
    // katalog/kunden/etc. nur für Admin+Büro lesbar. Für Namens-/Farb-Anzeige
    // (z.B. "Ich bin: ..."-Auswahl in Zeiterfassung/Aufgaben/Teamchat, die
    // auch normale Mitarbeiter sehen müssen) pflegt db.js parallel eine
    // öffentliche Teilmenge (nur Name/Farbe/Gewerk) in mitarbeiterOeffentlich,
    // die für alle drei Rollen lesbar ist.
    match /mitarbeiterOeffentlich/{docId} {
      allow read: if isAnyRole();
      allow write: if isAdminOrBuero();
    }

    // katalog/* enthält Einkaufspreise/Zuschläge (sensible Kalkulationsdaten)
    // - deshalb wie mitarbeiter nur für Admin+Büro lesbar. Für die reine
    // Artikelauswahl ohne Preise (z.B. "Verwendetes Material" in der
    // Projekt-Akte/Sprachnotiz, die auch normale Mitarbeiter nutzen dürfen)
    // pflegt db.js parallel eine öffentliche Teilmenge (nur Bezeichnung/
    // Einheit/Gewerk/Unterkategorie) in katalogOeffentlich, die für alle drei
    // Rollen lesbar ist.
    match /katalogOeffentlich/{docId} {
      allow read: if isAnyRole();
      allow write: if isAdminOrBuero();
    }

    // Push-Benachrichtigungs-Tokens (Firebase Cloud Messaging): ein Gerät
    // gehört genau einem Nutzer - jeder darf nur seine eigenen Token-
    // Dokumente anlegen/lesen/löschen. Das Versenden selbst läuft server-
    // seitig über den Cloudflare Worker mit einem Firebase-Service-Account
    // (Admin-Zugriff, umgeht diese Regeln) und liest dafür alle Tokens.
    match /pushTokens/{tokenId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Admin/Büro dürfen zusätzlich alle Tokens lesen, um z.B. bei einer
      // neuen Postfach-Nachricht alle admin/buero-Geräte benachrichtigen zu
      // können (siehe push.js notifyRoles) - Tokens sind reine Geräte-
      // Kennungen ohne Klartext-Wert außerhalb dieses Firebase-Projekts.
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminOrBuero());
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Kundenportal: rein lesend, ausschließlich die eigenen Dokumente
    // (Firestore prüft bei list-Abfragen die Regel gegen jedes zurückzu-
    // gebende Dokument - der Portal-Client fragt deshalb IMMER mit
    // where('kundeId','==', myKundeId()) ab, siehe portal/portal.js
    // fetchKundenScoped(); eine ungefilterte Abfrage würde diese Regel nicht
    // erfüllen und komplett abgelehnt, nicht etwa still gefiltert).
    match /kunden/{docId} {
      allow read: if isKunde() && myKundeId() == docId;
    }
    match /angebote/{docId} {
      allow read: if isKunde() && myKundeId() == resource.data.kundeId;
    }
    match /rechnungen/{docId} {
      allow read: if isKunde() && myKundeId() == resource.data.kundeId;
    }
    match /termine/{docId} {
      allow read: if isKunde() && myKundeId() == resource.data.kundeId;
    }

    // --- JARVIS (bewusst eigene, STRENGERE Regeln statt der generellen
    // isSensitiveCollection admin+büro-Stufe - der Rollout ist ausdrücklich
    // zunächst nur für admin vorgesehen, siehe cloudflare-worker/worker.js
    // Action "jarvis-chat"). Jede Erweiterung auf weitere Rollen passiert
    // hier UND im Worker gemeinsam, nie nur client-seitig. ---

    // Gesprächsverlauf: jeder Nutzer sieht/schreibt ausschließlich die eigenen
    // Unterhaltungen; admin zusätzlich lesend für Support-Zwecke (z.B. um
    // einen gemeldeten Fehlerfall nachzuvollziehen), aber nicht schreibend in
    // fremde Verläufe. Bewusst über uid (request.auth.uid) statt
    // mitarbeiterId verglichen - NICHT jeder Nutzer (insbesondere ein admin
    // ohne eigenen Mitarbeiter-Datensatz) hat zwingend ein mitarbeiterId,
    // uid existiert dagegen immer und braucht zusätzlich keinen separaten
    // get()-Lookup wie myMitarbeiterId().
    match /jarvisGespraeche/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Ausführbare Freigabe-Aktionen (Stufe 2), Job-Protokoll und Kosten-
    // zähler: NUR lesend für admin direkt aus dem Browser - jede
    // Statusänderung (Freigeben/Ausführen) läuft ausschließlich über den
    // Cloudflare Worker mit Service-Account, damit die Berechtigungs-/
    // Idempotenz-/Audit-Logik zentral an einer Stelle sitzt und nicht durch
    // einen manipulierten Browser-Schreibzugriff umgangen werden kann.
    match /jarvisAktionen/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /jarvisJobs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /jarvisKosten/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Dedup-Ledger für den autonomen E-Mail-Check (Phase 2) - verhindert,
    // dass dieselbe E-Mail bei einem erneuten Lauf (z.B. nächster Tag, oder
    // ein manueller Re-Trigger) nochmal eine Aufgabe/einen Entwurf erzeugt.
    match /jarvisEmailVerarbeitung/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Rechnungsentwürfe (Phase 3) - bewusst NICHT die echte Collection
    // "rechnungen" (die ist GoBD-gesperrt, siehe cloudflare-worker-ki-
    // buerokraft Kopfkommentar) - nur ein admin-lesbarer, worker-seitig
    // geschriebener Entwurf, der von einem Menschen final in Werkora als
    // echte Rechnung angelegt wird.
    match /jarvisRechnungsEntwuerfe/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Dedup-Ledger für vorbereitete (noch nicht versendete) Mahnstufen -
    // verhindert, dass dieselbe Mahnstufe zu derselben Rechnung zweimal
    // angelegt wird.
    match /jarvisMahnEntwuerfe/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Terminvorschläge für fällige Wartungen (Phase 4) - reine Vorschläge,
    // keine verbindliche Buchung (siehe cloudflare-worker/worker.js
    // runJarvisWartungsCheck).
    match /jarvisTerminVorschlaege/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Freigabe-/Versions-Metadaten zu JARVIS-Angebotsentwürfen (Phase 5) -
    // bewusst getrennt von der echten "angebote"-Collection (siehe
    // Kommentar bei wendeAngebotsFreigabeAn in cloudflare-worker/worker.js).
    match /jarvisAngebotsPruefung/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Monatlicher Kennzahlen-Schnappschuss für JARVIS CONTROL (Phase 6) -
    // ausschließlich zur Erkennung ungewöhnlicher Veränderungen gegenüber
    // dem Vormonat, siehe runJarvisControlCheck.
    match /jarvisKennzahlenVerlauf/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // JARVIS TECH (Phase 7) - Ergebnisse von Dokument-/Bild-/Text-Analysen.
    // Niemals clientseitig beschreibbar (auch die Verknüpfung mit einer
    // Anlage läuft über die serverseitige Aktion jarvis-tech-verknuepfen).
    match /jarvisTechAnalysen/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // DGUV/VDE-Prüfprotokoll-Entwürfe (Phase 7) - bewusst NIEMALS
    // clientseitig beschreibbar, auch nicht von admin (write:false wie alle
    // anderen jarvis*-Collections): das Protokoll bleibt ausschließlich über
    // die serverseitigen Aktionen jarvis-pruefprotokoll-erstellen/
    // -aktualisieren veränderbar, die die Grenzwertprüfung und
    // Kundenzuordnung erzwingen.
    match /jarvisPruefprotokolle/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Prüfnormen-Grenzwerte (Phase 9 Sicherheitsprüfung): bis Phase 8 eine
    // normale admin+büro-schreibbare Stammdaten-Collection wie "katalog" -
    // AB PHASE 9 bewusst "write: if false", da jede Änderung jetzt
    // ausschließlich über die serverseitigen, versionierenden Aktionen
    // erstelleJarvisPruefnorm/setzeJarvisPruefnormAusserKraft läuft (niemals
    // eine Löschung/Überschreibung einer bereits in Prüfprotokollen
    // verwendeten Fassung - siehe worker.js Kopfkommentar dort). Admin-only
    // lesbar wie die anderen jarvis*-Collections (vorher admin+büro).
    match /pruefnormenGrenzwerte/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Siri-Kurzbefehl-Gerätetokens (Phase 8): anders als die übrigen
    // jarvis*-Collections hier bewusst admin-SCHREIBBAR (nicht write:false) -
    // Danny selbst erstellt/widerruft Tokens direkt aus den Einstellungen
    // heraus, der Worker liest/aktualisiert sie nur für die eigentliche
    // Siri-Abfrage (letzteNutzungAm). Dokument-ID ist IMMER der SHA-256-Hash
    // des rohen Tokens, niemals das rohe Token selbst - siehe worker.js
    // sha256Hex/fuehreSiriAbfrageAus. Bewusst NICHT admin+büro (anders als
    // z.B. "katalog"/"pruefnormenGrenzwerte") - Siri-Zugriff auf Geschäfts-
    // daten bleibt wie JARVIS insgesamt admin-only.
    match /siriGeraeteTokens/{docId} {
      allow read, write: if isAdmin();
    }

    // Beleg-Vorschläge (Phase 11, bulkFixReceipts-Vorschlagsmodus, siehe
    // cloudflare-worker-ki-buerokraft/worker.js + verwaltung/js/
    // belegvorschlaege.js). Phase 11.1 Sicherheitskorrektur: lag diese
    // Collection bisher in isSensitiveCollection, griff also die GENERELLE
    // admin/büro-Regel unten (beliebiges read/write) - ein manipulierter
    // Browser-Request oder eine veränderte belegvorschlaege.js hätte damit
    // z.B. ausgabeId/alteWerte/neueWerte eines Vorschlags nachträglich
    // verändern, einen bereits entschiedenen Vorschlag erneut "freigeben"
    // oder sich selbst als Genehmiger eintragen können - die eigentliche
    // Versions-/Freigabelogik in belegvorschlaege.js ist NUR eine
    // Client-Konvention, keine Sicherheitsgrenze (siehe "Systemprompts sind
    // keine Sicherheitsgrenze", Phase 10 Punkt 1 - dasselbe Prinzip gilt für
    // Client-JavaScript). Diese Regel erzwingt serverseitig (durch Firestore
    // selbst), dass ein Vorschlag aus dem Browser NUR von offen in einen der
    // drei Endzustände wechseln kann, alle inhaltlichen Felder dabei
    // unverändert bleiben, und sich niemand als jemand anderes eintragen kann.
    //
    // Bewusst ADMIN-ONLY (nicht admin+büro wie "ausgaben" selbst): JARVIS/
    // KI-Bürokraft-Automation ist im gesamten bisherigen Rollout konsequent
    // auf admin beschränkt (siehe jarvisAktionen oben, siriGeraeteTokens,
    // und der Kommentar zu isSensitiveCollection weiter oben) - eine
    // Erweiterung auf büro ist eine eigene Geschäftsentscheidung, die (wie
    // dort beschrieben) explizit hier UND im Worker gemeinsam passieren
    // muss, nicht implizit dadurch, dass "ausgaben" zufällig admin+büro ist.
    match /belegVorschlaege/{docId} {
      allow read: if isAdmin();
      // Erzeugt wird ein Vorschlag ausschließlich serverseitig durch den
      // KI-Bürokraft-Worker (Service-Account, umgeht Security Rules per
      // Definition wie jeder authentifizierte Google-Cloud-Dienstzugriff) -
      // aus dem Browser (Firebase-Auth-Nutzer) darf NIE einer neu angelegt werden.
      allow create: if false;
      allow update: if isAdmin()
        && resource.data.status == 'offen'
        && request.resource.data.status in ['freigegeben', 'abgelehnt', 'veraltet']
        // Inhaltliche Felder (was vorgeschlagen wurde) dürfen eine Freigabe-
        // Entscheidung nicht nachträglich verändern.
        && request.resource.data.ausgabeId == resource.data.ausgabeId
        && request.resource.data.alteWerte == resource.data.alteWerte
        && request.resource.data.neueWerte == resource.data.neueWerte
        && request.resource.data.erwarteteVersion == resource.data.erwarteteVersion
        // Niemand darf eine Freigabe/Ablehnung im Namen eines anderen Nutzers eintragen.
        && (request.resource.data.status != 'freigegeben' || request.resource.data.freigegebenVonUid == request.auth.uid)
        && (request.resource.data.status != 'abgelehnt' || request.resource.data.abgelehntVonUid == request.auth.uid);
      allow delete: if false;
    }

    match /{collectionId}/{docId} {
      allow read, write: if isSignedIn() && (
        (isSensitiveCollection(collectionId) && isAdminOrBuero()) ||
        (isSharedCollection(collectionId) && isAnyRole())
      );
    }
  }
}
