rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // P0-Sicherheitskorrektur (Oktober 2026, Master-Audit Bericht 03,
    // Finding #8: "storage.rules: Zugriff nach Pfad-Präfix einschränken,
    // wo möglich"): vorher durfte JEDER eingeloggte Nutzer (admin, büro,
    // mitarbeiter, techniker, UND kunde-Portal-Accounts) per catch-all
    // {allPaths=**} lesen/schreiben - ohne Rücksicht auf Pfad oder Inhalt.
    //
    // Eine ECHTE, rollenbasierte Einschränkung (wie in firestore.rules
    // über get() auf die Firestore-Collection "users") wurde geprüft, aber
    // bewusst NICHT umgesetzt: Storage Rules können laut Firebase-Doku per
    // firestore.get()/firestore.exists() zwar in PRODUKTION auf Firestore
    // zugreifen, das Firebase Local Emulator Suite unterstützt diese
    // Cross-Service-Prüfung aber nicht zuverlässig (empirisch am
    // 29.10.2026 gegen den echten Emulator nachgewiesen: dieselbe Regel
    // lieferte für JEDE Rolle - auch admin - einen "Null value error" und
    // pauschale Ablehnung, siehe Commit-Beschreibung). Eine Regel, die sich
    // nicht gegen den Emulator verifizieren lässt, bevor sie live geht, ist
    // hier bewusst nicht erwünscht (Rücksprache mit Danny, 29.10.2026) -
    // stattdessen diese testbare, pfadbasierte Variante:
    //
    //  - Nur noch genau die Pfad-Präfixe erlaubt, die die App tatsächlich
    //    verwendet (siehe uploadBlobToStorage()-Aufrufe in verwaltung/js/)
    //    - alles andere wird jetzt grundsätzlich abgelehnt (vorher: alles
    //      erlaubt). Schließt die Möglichkeit, beliebige/unerwartete Pfade
    //      zu beschreiben oder zu lesen.
    //  - Je Bereich ein zum tatsächlichen Inhalt passender Dateityp- und
    //    Größen-Grenzwert (Belege/Fotos/Zeiterfassung = Bild oder PDF,
    //    enger als die bisherige pauschale 25-MB-Grenze für alles).
    //  - Lesen bleibt bewusst "jeder eingeloggte Nutzer" (wie bisher) -
    //    eine echte Rollentrennung beim Lesen bräuchte denselben, hier
    //    nicht verifizierbaren Cross-Service-Zugriff. Der eigentliche
    //    Schutz sensibler Daten (z.B. Ausgaben/Belege) passiert weiterhin
    //    primär in firestore.rules: nur wer das zugehörige Firestore-
    //    Dokument lesen darf (Admin/Büro), erfährt überhaupt den genauen
    //    Storage-Pfad/Download-Token.
    function istEingeloggt() { return request.auth != null; }
    function istBildOderPdf() {
      return request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf';
    }
    function istBild() {
      return request.resource.contentType.matches('image/.*');
    }

    // Ausgaben/Belege (Finanzbelege) - Fotos oder gescannte PDFs, siehe
    // ausgaben.js/belegimport.js/postfach.js.
    match /ausgaben/{belegId} {
      allow read: if istEingeloggt();
      allow write: if istEingeloggt() && istBildOderPdf() && request.resource.size < 15 * 1024 * 1024;
    }

    // Allgemeine Dokumente (Arbeitsberichte als PDF, Kunden-Upload-Link-
    // Dateien, Projektdokumente) - siehe dokumente.js, kunde-upload-Route
    // im Haupt-Worker.
    match /dokumente/{bezugTyp}/{bezugId}/{docId} {
      allow read: if istEingeloggt();
      allow write: if istEingeloggt() && istBildOderPdf() && request.resource.size < 25 * 1024 * 1024;
    }

    // Aufmaß-Fotos - siehe aufmass.js.
    match /aufmasse/{projektId}/{docId} {
      allow read: if istEingeloggt();
      allow write: if istEingeloggt() && istBild() && request.resource.size < 15 * 1024 * 1024;
    }

    // Projektfotos - siehe fotos.js.
    match /fotos/{projektId}/{docId} {
      allow read: if istEingeloggt();
      allow write: if istEingeloggt() && istBild() && request.resource.size < 15 * 1024 * 1024;
    }

    // Social-Media-Beitragsbilder - siehe views/social.js.
    match /socialPosts/{dateiname} {
      allow read: if istEingeloggt();
      allow write: if istEingeloggt() && istBild() && request.resource.size < 15 * 1024 * 1024;
    }

    // Zeiterfassung: Fotos/Unterschriften zu einem Arbeitszeiteintrag -
    // siehe views/zeiterfassung.js (medien/{id} und unterschrift).
    match /zeiterfassung/{entryId}/{rest=**} {
      allow read: if istEingeloggt();
      allow write: if istEingeloggt() && istBild() && request.resource.size < 10 * 1024 * 1024;
    }

    // Kein {allPaths=**}-Catch-all mehr: jeder nicht oben gelistete Pfad
    // wird von Firebase Storage automatisch abgelehnt (Standardverhalten
    // ohne passende Regel ist "kein Zugriff").
  }
}
