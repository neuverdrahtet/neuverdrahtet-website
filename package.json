{
  "name": "neuverdrahtet-website",
  "private": true,
  "description": "Entwicklungs-Abhängigkeiten für lokale Tests (Firestore-Regel-Tests, Node-Unit-Tests, Browser-Smoke-Test) - NICHT Teil der Cloudflare-Worker-Laufzeit (die hat keine package.json/node_modules, siehe cloudflare-worker/README.md).",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore \"node firestore-tests/rules.test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --only storage \"node firestore-tests/storage-rules.test.mjs\"",
    "test:belegvorschlaege": "firebase emulators:exec --only firestore --config firestore-tests/firebase.testconfig.json --project demo-test \"node firestore-tests/belegvorschlaege.test.mjs\"",
    "test:rechnungsnummer-concurrency": "firebase emulators:exec --only firestore \"node firestore-tests/rechnungsnummer-concurrency.test.mjs\"",
    "test:browser-smoke": "node verwaltung/tests/browser-smoke.test.mjs",
    "test:unit": "node scripts/run-all-tests.mjs",
    "test:all": "npm run test:unit && npm run test:rules && npm run test:storage-rules && npm run test:rechnungsnummer-concurrency",
    "build:bss": "node berger-service-solutions/src/build.mjs",
    "test:bss": "node berger-service-solutions/tests/logik.test.mjs && node berger-service-solutions/tests/site-qualitaet.test.mjs",
    "test:bss-browser": "node berger-service-solutions/tests/browser/buchung-e2e.test.mjs",
    "start:bss": "node berger-service-solutions/tests/hilfen/server.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.4.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.0.0",
    "playwright": "^1.56.1",
    "xhr2": "^0.2.1"
  }
}
