                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "supplier": {
                    "type": "string"
                  },
                  "amount_net": {
                    "type": "number"
                  },
                  "amount_gross": {
                    "type": "number"
                  },
                  "vat_rate": {
                    "type": "number"
                  },
                  "paid_with": {
                    "type": "string"
                  },
                  "customer_id": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  }
                }
              }
            }
