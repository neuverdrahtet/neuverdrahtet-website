{
  "openapi": "3.1.0",
  "info": {
    "title": "Werkora KI-Bürokraft API",
    "description": "Liest und schreibt Geschäftsdaten (Kunden, Leads, Projekte, Aufgaben, Termine, Angebote, Rechnungen u.a.) für die Firma neuverdrahtet. Sensible Aktionen (Versand, Löschen) sind serverseitig gesperrt und erscheinen nicht in dieser Schnittstelle.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://neuverdrahtet-ki-buerokraft.neuverdrahtetworkersdev.workers.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/customers": {
      "get": {
        "operationId": "searchCustomers",
        "summary": "Kunden suchen",
        "description": "Vor dem Anlegen eines neuen Kunden IMMER zuerst hiermit prüfen, ob er schon existiert (per E-Mail oder Telefon).",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "phone",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sucht in Firma/Name und Ansprechpartner"
          },
          {
            "name": "postal_code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste der gefundenen Kunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCustomer",
        "summary": "Neuen Kunden anlegen",
        "description": "Neuer Kunde bekommt automatisch Status \"lead\". Gibt 409 zurück, wenn E-Mail/Telefon schon existiert.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Firma oder vollständiger Name (Pflicht, wenn 'company' fehlt)"
                  },
                  "company": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "private",
                      "company"
                    ]
                  },
                  "contact_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "street": {
                    "type": "string"
                  },
                  "postal_code": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Angelegter Kunde",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "operationId": "getCustomer",
        "summary": "Einen Kunden abrufen",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Kunde",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateCustomer",
        "summary": "Kunde aktualisieren",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "company": {
                    "type": "string"
                  },
                  "contact_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "street": {
                    "type": "string"
                  },
                  "postal_code": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aktualisierter Kunde",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/leads": {
      "get": {
        "operationId": "searchLeads",
        "summary": "Leads abrufen (Kunden im Status 'lead' oder anderem Status)",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Werkora-Status wie 'lead', 'interessent', 'kunde', 'verloren'. Ohne Angabe: nur 'lead'."
          }
        ],
        "responses": {
          "200": {
            "description": "Liste",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createLead",
        "summary": "Lead anlegen (neuer Kunde oder Notiz an bestehendem Kunden)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Falls der Kunde schon existiert (per searchCustomers gefunden)"
                  },
                  "title": {
                    "type": "string",
                    "description": "Pflicht, wenn kein customer_id angegeben ist"
                  },
                  "description": {
                    "type": "string"
                  },
                  "trade": {
                    "type": "string",
                    "description": "Gewerk, z.B. elektro"
                  },
                  "source": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string"
                  },
                  "estimated_value": {
                    "type": "number"
                  },
                  "next_action": {
                    "type": "string"
                  },
                  "next_action_date": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Angelegter/aktualisierter Lead",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/leads/{id}": {
      "patch": {
        "operationId": "updateLead",
        "summary": "Lead aktualisieren (Status, nächster Schritt, Notiz)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "description": "Nur bekannte Werkora-Status-Werte ändern den Status wirklich, sonst wird nur eine Notiz vermerkt."
                  },
                  "next_action": {
                    "type": "string"
                  },
                  "next_action_date": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aktualisierter Lead",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "searchProjects",
        "summary": "Projekte abrufen",
        "parameters": [
          {
            "name": "customer_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
