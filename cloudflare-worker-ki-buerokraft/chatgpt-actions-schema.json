    "/articles/{id}/stock-movements": {
      "get": {
        "operationId": "searchStockMovements",
        "summary": "Lagerbewegungen eines Artikels abrufen (nur lesen)",
        "description": "Historie der Zu-/Abgänge, neueste zuerst.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste der Lagerbewegungen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createStockMovement",
        "summary": "Materialentnahme oder Wareneingang buchen",
        "description": "Bucht einen Lagerbestand-Zu- oder -Abgang und aktualisiert den Bestand des Artikels sofort. delta positiv = Zugang (Wareneingang), delta negativ = Entnahme/Verbrauch. Funktioniert nur bei Artikeln mit aktivierter Bestandsführung (stock != null bei searchArticles/getArticle). Der Bestand wird bei einer Entnahme über den vorhandenen Bestand hinaus auf 0 begrenzt, nie negativ.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "delta"
                ],
                "properties": {
                  "delta": {
                    "type": "number",
                    "description": "Menge ungleich 0. Positiv = Zugang, negativ = Entnahme."
                  },
                  "reason": {
                    "type": "string",
                    "description": "z.B. \"Für Projekt Müller entnommen\" oder \"Wareneingang Lieferant X\""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Aktualisierter Artikel inkl. gebuchter Bewegung",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    }
  }
