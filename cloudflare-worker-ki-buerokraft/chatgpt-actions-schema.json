    "/expenses/{id}/analyze-receipt": {
      "post": {
        "operationId": "analyzeReceipt",
        "summary": "Beleg-Foto per KI auslesen und mit dem gespeicherten Datensatz vergleichen",
        "description": "Liest den echten Inhalt des Belegs aus (Foto oder PDF, nicht nur gespeicherte Felder). Liefert current (DB-Stand) und detected (erkannt) zum Vergleich, ändert nichts automatisch. Bei Abweichung danach updateExpense aufrufen.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vergleich aktueller Datensatz vs. erkannter Beleginhalt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/expenses/bulk-fix-receipts": {
      "post": {
        "operationId": "bulkFixReceipts",
        "summary": "Mehrere 0-Euro-Belege in einem Aufruf per KI auslesen und direkt korrigieren",
        "description": "Verarbeitet bis zu limit Belege ohne Betrag serverseitig: liest jeden per KI aus, übernimmt bei sicher lesbaren Belegen Betrag/Datum/Lieferant sofort (Kategorie nur bei hoher Sicherheit). Für viele Belege statt analyzeReceipt einzeln nutzen - mit has_more wiederholen, bis fertig.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "description": "Wie viele Belege in diesem Aufruf verarbeitet werden (1-25, Default 10). Kleinere Werte sind zuverlässiger, größere schneller fertig."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ processed, updated, needs_manual_review, remaining_incomplete, has_more }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
