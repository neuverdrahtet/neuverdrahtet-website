    "/price-list": {
      "get": {
        "operationId": "getPriceList",
        "summary": "Komplette Preisliste (Artikel+Leistungen) abrufen (nur lesen)",
        "parameters": [
          {
            "name": "trade",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "low_stock",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "true = nur Artikel mit Bestand <= Mindestbestand (nur bei Artikeln mit aktivierter Bestandsführung relevant)"
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "true = nur die Anzahl liefern (als {\"count\": <Zahl>}) statt der vollen Liste. Bei reinen Zählfragen ('Wie viele Positionen sind in der Preisliste?') immer count=true statt der vollen Liste nutzen."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Maximale Anzahl Ergebnisse (Default und Obergrenze: 100)."
          }
        ],
        "responses": {
          "200": {
            "description": "Liste",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
