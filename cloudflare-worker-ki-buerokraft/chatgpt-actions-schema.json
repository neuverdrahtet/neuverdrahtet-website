    "/articles/{id}/stock-movements": {
      "post": {
        "operationId": "createStockMovement",
        "summary": "Materialentnahme oder Wareneingang buchen",
        "description": "Bucht einen Lagerbestand-Zu- oder -Abgang, aktualisiert den Bestand sofort. delta positiv = Zugang, negativ = Entnahme. Nur bei Artikeln mit aktivierter Bestandsführung (stock != null). Bestand wird bei Entnahme über den Bestand hinaus auf 0 begrenzt, nie negativ.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "delta"
                ],
                "properties": {
                  "delta": {
                    "type": "number",
                    "description": "Menge ungleich 0. Positiv = Zugang, negativ = Entnahme."
                  },
                  "reason": {
                    "type": "string",
                    "description": "z.B. \"Für Projekt Müller entnommen\" oder \"Wareneingang Lieferant X\""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Aktualisierter Artikel inkl. gebuchter Bewegung",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    }
